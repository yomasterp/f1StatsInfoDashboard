# Copy this file to .env and replace the placeholders with local credentials.
DATABASE_URL=postgresql://postgres:replace-with-your-password@localhost:5432/f1_race_dashboard

# News-provider credentials stay server-side and must never use NEXT_PUBLIC_* variables.
NEWS_PROVIDER=newsdata
NEWSDATA_API_KEY=replace-with-your-newsdata-key
NEWSDATA_API_BASE_URL=https://newsdata.io/api/1
NEWSDATA_API_QUERY='"Formula 1" OR F1'
NEWSDATA_API_LANGUAGE=en
NEWSDATA_API_CATEGORY=sports

# Optional local-development-only NewsAPI adapter. Set NEWS_PROVIDER=newsapi to use it.
NEWS_API_KEY=replace-with-your-newsapi-key
NEWS_API_BASE_URL=https://newsapi.org/v2
NEWS_API_QUERY='"Formula 1" OR "F1"'
NEWS_API_LANGUAGE=en
NEWS_API_PAGE_SIZE=50
