{
  "name": "f1-race-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "fallow": "fallow audit --type-aware --gate all",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "db:check": "node scripts/check-database.mjs",
    "db:generate": "node --require ./scripts/drizzle-kit-windows-shim.cjs ./node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node scripts/migrate.mjs"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "next": "16.3.2",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.2",
    "@types/node": "24.12.0",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "9.39.1",
    "eslint-config-next": "16.3.2",
    "fallow": "^3.17.0",
    "tailwindcss": "4.2.2",
    "typescript": "5.9.3",
    "vitest": "^4.1.11"
  }
}
